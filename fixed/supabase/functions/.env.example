# Settings for the server functions. Copy to supabase/functions/.env (which is
# not committed) and fill in. The server functions read it when Supabase starts.

# Every email goes to the local test mailbox; nothing reaches real people.
MAILPIT_URL=http://supabase_inbucket_nordaloom:8025
# Product photos in emails must load in the mailbox, i.e. from the browser's side.
PUBLIC_SUPABASE_URL=http://127.0.0.1:57321
EMAIL_FROM=Nordaloom <owner@nordaloom.example>

# Card payments (Stripe). Test mode keys start with sk_test_ and whsec_.
STRIPE_SECRET_KEY=
# Only needed if Stripe can reach this server (or through the Stripe CLI; see README).
STRIPE_WEBHOOK_SECRET=
