{
  "name": "nordaloom-shop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:migrate": "npx supabase migration up --db-url postgresql://postgres:postgres@127.0.0.1:57322/postgres",
    "db:seed": "node scripts/run-sql.mjs supabase/seed.sql",
    "db:build-seed": "node scripts/build-seed.mjs",
    "photos:upload": "node scripts/upload-photos.mjs",
    "demo:add": "node scripts/demo-history.mjs",
    "demo:remove": "node scripts/demo-history.mjs --remove",
    "test": "vitest run",
    "test:browser": "playwright test --project=shop",
    "test:app": "npm run build && playwright test --project=app"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/query-sync-storage-persister": "^5.104.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-persist-client": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "pg": "^8.23.0",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
